# Google Gemini API (gratuita)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui

# Instagram API (via Facebook Graph API)
INSTAGRAM_ACCESS_TOKEN=seu-token-instagram-aqui
INSTAGRAM_BUSINESS_ACCOUNT_ID=seu-id-de-conta-aqui

# Facebook API
FACEBOOK_ACCESS_TOKEN=seu-token-facebook-aqui
FACEBOOK_PAGE_ID=seu-id-da-pagina-aqui
